# Copia este archivo como .env y rellena los valores.

# Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# 10.0.2.2 es tu PC vista desde el emulador de Android.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# En dev se permite cualquier origen. En prod: CORS_ALLOW_ALL_ORIGINS=False
# y lista los orígenes separados por comas en CORS_ALLOWED_ORIGINS.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

# Ruta al JSON de la cuenta de servicio de Firebase (relativa a la raíz o absoluta)
FIREBASE_CREDENTIALS=service-account.json
